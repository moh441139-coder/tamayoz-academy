# كلمة مرور لوحة المشرف (إلزامي)
ADMIN_PASSWORD=change-me-strong-password

# سر توقيع الجلسات (اختياري لكن موصى به - 32 حرفاً عشوائياً على الأقل)
SESSION_SECRET=

# Upstash Redis (يضاف تلقائياً عند ربط Upstash من Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# أو بالأسماء البديلة من تكامل Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Vercel Blob (يضاف تلقائياً عند إنشاء Blob Store من لوحة Vercel)
BLOB_READ_WRITE_TOKEN=

# رابط الموقع النهائي (اختياري - يُستخدم في QR وOpen Graph)
NEXT_PUBLIC_SITE_URL=
